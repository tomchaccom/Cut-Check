{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/js/ui/pyworker.js",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src https://cdn.jsdelivr.net 'wasm-unsafe-eval' 'unsafe-eval'; connect-src https://cdn.jsdelivr.net" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/landing.html" }
  ],
  "functions": {
    "api/generate-mission.py": { "maxDuration": 60 },
    "api/mission-steps.py": { "maxDuration": 60 },
    "api/tutor.py": { "maxDuration": 30 },
    "api/tutor-recap.py": { "maxDuration": 30 },
    "api/create-student.py": { "maxDuration": 30 },
    "api/admin.py": { "maxDuration": 30 }
  }
}
